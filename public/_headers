# Long-lived cache for fingerprinted Vite assets (filenames contain a hash).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts: stable filenames, safe to cache forever.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Optimized images generated by scripts/optimize-images.mjs — stable filenames.
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Favicon and OG image: stable filenames, long cache.
/favicon-32.png
  Cache-Control: public, max-age=31536000, immutable
/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable
/og-default.jpg
  Cache-Control: public, max-age=31536000, immutable

# HTML pages must be revalidated each visit so SEO/content changes ship immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# sitemap + robots: short cache so updates propagate.
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600

# Security headers (defense in depth).
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
